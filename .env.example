# Example only: no real secret here. The real files live outside the repo (never in git).
#
# DUMONTECH_HOME (default ~/.dumontech):
#   $DUMONTECH_HOME/shared/bots.env                  bots of every repo (kept by Infrastructure, chmod 600)
#   $DUMONTECH_HOME/projetos/<repo-slug>/.env        this repo's .env (folders 700, file 600)
#
# Keys shared by several applications on the machine (ADR-009), one file per subject:
#   $DUMONTECH_HOME/shared/login-social.env          social login (later smtp.env, pagamento.env)
# Same NAME=value format, folder 700, file 600. The method never reads or loads them: each
# application reads them its own way, and the application's own .env wins. A secret used by
# one application only stays in that application's .env.
#
# Search order of the repo .env: PROCESS_ENV_FILE, the path above,
# ~/.<repo-slug>/.env, ~/.config/<repo-slug>/.env (legacy, warns).
# Create it with: .method/scripts/init-env.sh
#
# Bot keys, one trio per slug of .github/bots.tsv (slug bot-a shown). They go in
# shared/bots.env; while that file exists they are read only from there, and a
# declared bot missing from it is an error. Without it, they go in the repo .env.
BOT_WEBHOOK_BOT_A_URL=
BOT_WEBHOOK_BOT_A_SECRET=
GH_APP_BOT_A_TOKEN=
# Method agent token (always in the repo .env).
GH_APP_METHOD_TOKEN=
