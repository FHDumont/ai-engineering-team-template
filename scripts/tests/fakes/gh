#!/usr/bin/env bash
# Fake gh of the tests: records the call and delegates to the handler of the test.
# The handler is a piece of Bash loaded here, with "$@" = the gh arguments.
#
# It knows how to fail: FAKE_GH_FAIL is an extended regex matched against the
# whole call ("$*"). A call that matches prints FAKE_GH_FAIL_MSG (default
# "gh: forced failure") on stderr and exits FAKE_GH_FAIL_STATUS (default 1)
# without running the handler. The handler may also `exit <n>` by itself.
printf '%s\n' "$*" >>"${FAKE_GH_LOG:?FAKE_GH_LOG not set}"
if [ -n "${FAKE_GH_FAIL:-}" ] && printf '%s' "$*" | grep -qE -- "$FAKE_GH_FAIL"; then
  echo "${FAKE_GH_FAIL_MSG:-gh: forced failure}" >&2
  exit "${FAKE_GH_FAIL_STATUS:-1}"
fi
# The merged PR of the base commit (phase-start.sh): FAKE_BASE_PR is none (default), green,
# red, tree (CI green but another tree) or open (not merged). The check-runs of its head
# (sha headpr1) and the tree of its head commit are answered here.
case "$*" in
  "api repos/$GH_REPO/commits/"*"/pulls")
    case "${FAKE_BASE_PR:-none}" in
      none) echo '[]' ;;
      *) merged='"2026-01-02T00:00:00Z"'; [ "$FAKE_BASE_PR" != open ] || merged=null
         printf '[{"number":30,"merged_at":%s,"head":{"sha":"headpr1"}}]\n' "$merged" ;;
    esac
    exit 0 ;;
  "api repos/$GH_REPO/commits/headpr1/check-runs?per_page=100")
    if [ "$FAKE_BASE_PR" = red ]; then
      echo '{"check_runs":[{"name":"CI","status":"completed","conclusion":"failure","started_at":"2026-01-01T00:00:00Z","html_url":"https://github.com/owner/repo/actions/runs/30"}]}'
    else
      echo '{"check_runs":[{"name":"CI","status":"completed","conclusion":"success","started_at":"2026-01-01T00:00:00Z","html_url":"https://github.com/owner/repo/actions/runs/30"}]}'
    fi
    exit 0 ;;
  "api repos/$GH_REPO/git/commits/headpr1")
    if [ "$FAKE_BASE_PR" = tree ]; then echo '{"tree":{"sha":"0000000000000000000000000000000000000000"}}'
    else printf '{"tree":{"sha":"%s"}}\n' "$(git rev-parse 'origin/main^{tree}')"; fi
    exit 0 ;;
esac
# The check "CI" of the base commit (phase-start.sh): FAKE_BASE_CI is green (default), red,
# running, absent or wait (running on the first FAKE_BASE_CI_RUNNING reads, then green: the
# run of main that finishes while phase-start.sh waits for it).
case "$*" in
  "api repos/$GH_REPO/commits/"*"/check-runs?per_page=100")
    ci_mode="${FAKE_BASE_CI:-green}"
    if [ "$ci_mode" = wait ]; then
      reads="$(cat "$FAKE_BASE_CI_COUNT" 2>/dev/null || echo 0)"
      echo "$((reads + 1))" >"$FAKE_BASE_CI_COUNT"
      if [ "$reads" -lt "${FAKE_BASE_CI_RUNNING:-2}" ]; then ci_mode=running; else ci_mode=green; fi
    fi
    case "$ci_mode" in
      green) echo '{"check_runs":[{"name":"lint","status":"completed","conclusion":"failure"},{"name":"CI","status":"completed","conclusion":"success","started_at":"2026-01-02T00:00:00Z","html_url":"https://github.com/owner/repo/actions/runs/2"}]}' ;;
      red) echo '{"check_runs":[{"name":"CI","status":"completed","conclusion":"failure","started_at":"2026-01-02T00:00:00Z","html_url":"https://github.com/owner/repo/actions/runs/3"}]}' ;;
      running) echo '{"check_runs":[{"name":"CI","status":"in_progress","conclusion":null,"started_at":"2026-01-02T00:00:00Z","html_url":"https://github.com/owner/repo/actions/runs/4"}]}' ;;
      absent) echo '{"check_runs":[{"name":"lint","status":"completed","conclusion":"success"}]}' ;;
    esac
    exit 0 ;;
esac
# FAKE_SETUP (set by fake_setup of lib.sh) answers the four reads of
# `setup-repo.sh --check` before the handler of the test: ok (configured),
# nolabels, noprotection, offer (an unanswered offer), freeplan (no branch protection,
# mode not recorded) or unprotected (no branch protection, PROCESS_BRANCH_MODE recorded).
if [ -n "${FAKE_SETUP:-}" ]; then
  case "$*" in
    "label list --repo $GH_REPO --limit 500 --json name,color,description")
      if [ "$FAKE_SETUP" = nolabels ]; then echo '[]'; else cat "$FAKE_SETUP_LABELS"; fi
      exit 0 ;;
    "api repos/$GH_REPO")
      echo '{"private":true,"allow_auto_merge":true,"allow_merge_commit":false,"allow_squash_merge":false,"allow_rebase_merge":true,"delete_branch_on_merge":true}'
      exit 0 ;;
    "api repos/$GH_REPO/branches/main/protection")
      case "$FAKE_SETUP" in
        noprotection) echo '{"message":"Branch not protected"}'; exit 1 ;;
        freeplan|unprotected)
          echo "gh: Upgrade to GitHub Pro or make this repository public to enable this feature. (HTTP 403)" >&2
          exit 1 ;;
      esac
      echo '{"required_status_checks":{"strict":false,"checks":[{"context":"review/independent","app_id":null},{"context":"CI","app_id":15368}]},"enforce_admins":{"enabled":true},"required_pull_request_reviews":{"required_approving_review_count":0},"required_linear_history":{"enabled":true},"allow_force_pushes":{"enabled":false},"allow_deletions":{"enabled":false}}'
      exit 0 ;;
    "variable list --repo $GH_REPO --json name --jq .[].name")
      [ "$FAKE_SETUP" = offer ] || printf 'PROCESS_OFFER_PROJECT\nPROCESS_OFFER_RUNNER\n'
      [ "$FAKE_SETUP" != unprotected ] || echo PROCESS_BRANCH_MODE
      exit 0 ;;
  esac
fi
if [ -n "${FAKE_GH_HANDLER:-}" ] && [ -f "$FAKE_GH_HANDLER" ]; then
  # shellcheck disable=SC1090
  source "$FAKE_GH_HANDLER"
fi
exit 0
