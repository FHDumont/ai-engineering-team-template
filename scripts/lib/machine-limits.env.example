# Machine limits of the method: shared by every project, bot and person on this
# machine. First run copies this file to ~/.config/ai-method/machine-limits.env;
# edit that copy. Plain NAME=value lines (no quotes, no spaces). A variable already
# set in the environment wins over this file. Default in each comment.

# SLOTS_VALIDATE (default 2, unit: runs): validate.sh runs allowed at the same time
# on the whole machine. The next one waits in a queue ("waiting for a validate slot").
AI_METHOD_SLOTS_VALIDATE=2

# TEST_JOBS (default CPUs / SLOTS_VALIDATE, at least 1, unit: tests): tests of one
# validate.sh run at the same time, each in its own temporary folder. 1 = in series.
# Left commented, the default follows the CPUs and respects the validate slots.
# AI_METHOD_TEST_JOBS=4

# SLOTS_FASE (default 3, unit: phases): phases open at the same time on the whole
# machine. new-phase.sh and open-parallel.sh exit 75 without creating anything when
# none is free. A slot frees itself when the worktree of the phase is gone.
AI_METHOD_SLOTS_FASE=3

# WAIT_TIMEOUT_SECONDS (default 1200, unit: seconds): how long validate.sh waits for
# a slot or for the run of the same worktree before giving up (exit 4).
AI_METHOD_WAIT_TIMEOUT_SECONDS=1200

# POLL_SECONDS (default 2, unit: seconds): pause between two looks at a busy queue.
AI_METHOD_POLL_SECONDS=2

# WARN_LOAD1 (default 8, unit: load average of 1 minute): above it the status and the
# start of a phase warn. Warning only: nothing is blocked (the load gate is issue #12).
AI_METHOD_WARN_LOAD1=8

# WARN_FREE_MEM_MB (default 1024, unit: MB): free memory below it warns.
AI_METHOD_WARN_FREE_MEM_MB=1024

# WARN_SWAP_MB (default 2048, unit: MB): swap in use above it warns.
AI_METHOD_WARN_SWAP_MB=2048

# TEST_TIMEOUT_SECONDS (default 600, unit: seconds): the time limit of a test that sets
# an alarm or waits. It is multiplied by ceil(load1 / WARN_LOAD1) when the load is above
# WARN_LOAD1, so a machine loaded by phases of several projects never fails a test by time.
AI_METHOD_TEST_TIMEOUT_SECONDS=600

# LINT_BASE (default main, unit: git ref): validate.sh --lint (without --full) runs
# shellcheck only on the files changed against the merge-base with this ref.
AI_METHOD_LINT_BASE=main

# IDLE_HOURS (default 4, unit: hours): a session idle for longer is "stopped": sessions.sh
# --close-idle stops the headless ones, and the end of a phase lists the app sessions
# not archived and idle for longer (the owner archives them in the app).
AI_METHOD_IDLE_HOURS=4
